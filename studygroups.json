{
  "_instructions": {
    "_readme": "HOW TO ADD/UPDATE STUDY GROUP DATA — Read this before editing!",
    "_howToAddNewCohort": [
      "1. Copy an existing studyGroup block (everything from { 'number':... to the closing }).",
      "2. Increment 'number', update 'name', 'dateRange', and 'description'.",
      "3. Add all lessons for this cohort inside the 'lessons' array (newest lesson first).",
      "4. Add the new cohort at the TOP of the 'studyGroups' array.",
      "5. Upload studygroups.json to S3 and hard-refresh the site."
    ],
    "_howToAddNewLesson": [
      "1. Find the correct studyGroup by number in the 'studyGroups' array.",
      "2. Add a new lesson object at the TOP of its 'lessons' array (newest first).",
      "3. Fill in: number, topic, date.",
      "4. Paste Google Drive share link into recording.url and/or summary.url.",
      "5. Leave any unused 'url' as empty string '' — the button will be hidden automatically.",
      "6. 'quizzes' is an array of quiz links: [ { url, label } ] — a Google Form or a Quizlet set.",
      "7. Lessons without slides, links or quizzes can omit the 'presentation', 'links' and 'quizzes' keys entirely.",
      "7. Upload studygroups.json to S3 and hard-refresh the site."
    ],
    "_fields": {
      "studyGroups[].number": "Cohort number (integer). Used to display 'Study Group #N' on the card.",
      "studyGroups[].name": "Display name shown on the card, e.g. 'Study Group #1'.",
      "studyGroups[].dateRange": "Human-readable date range, e.g. 'Nov 2025 – Jan 2026'. Shown on the card.",
      "studyGroups[].description": "Short description of the cohort. Shown on the card.",
      "lessons[].number": "Lesson number within this cohort (integer). Shown as 'Lesson #N'.",
      "lessons[].topic": "What this lesson covers. Shown as subtitle in the accordion header.",
      "lessons[].date": "Date this lesson took place, e.g. 'Dec 27, 2025'.",
      "lessons[].recording.url": "Google Drive or Zoom Cloud share link. Set to empty '' to hide the button.",
      "lessons[].recording.label": "Button text, e.g. 'Lesson 8 Recording'.",
      "lessons[].summary.url": "Link to AI meeting summary doc (Google Drive, Notion, etc.). Empty '' hides it.",
      "lessons[].summary.label": "Button text, e.g. 'Lesson 8 AI Summary'.",
      "lessons[].presentation.url": "Relative S3 path, e.g. 'assets/presentations/filename.pdf'. Empty '' hides it.",
      "lessons[].presentation.label": "Button text, e.g. 'Lesson 8 Slides (PDF)'.",
      "lessons[].links": "Array of useful links. Each: { 'label': 'Link text', 'url': 'https://...', 'type': 'youtube' or 'docs' }. Empty array [] hides the section.",
      "lessons[].quizzes": "Array of quiz links shown as buttons under the player. Each: { 'url': '...', 'label': '...' }, e.g. a Google Form quiz or a Quizlet set. Empty url '' hides that button; omit the key when there is none.",
      "lessons[].practiceTopics": "OPTIONAL. Practice topics for this one lesson's 'Practice this lesson' button, overriding the curriculum below. Use topic names exactly as they appear in the Practice tab's Section filter.",
      "curriculum": "Lesson title → practice topics. The same lesson titles repeat in every cohort, so the 'Practice this lesson' button is set up once here. Titles must match lessons[].topic exactly. A title mapped to [\"TIMED\"] offers a timed mock exam instead."
    },
    "_tip": "Any field with url set to empty string '' is automatically hidden from the UI. You never need to delete a field — just clear the url."
  },
